{
  "name": "jevsteer",
  "version": "0.4.0",
  "description": "Host-planned, verified low-cost browser execution with Jev, Playwright and legacy Kapture.",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "bin": {
    "jevsteer": "./bin/jevsteer.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "examples/",
    "docs/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "AGENTS.md",
    "CLAUDE.md",
    ".env.example"
  ],
  "scripts": {
    "start": "node bin/jevsteer.mjs",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "browser:install": "playwright-core install chromium",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:live": "node scripts/live-scenarios.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "cheerio": "^1.1.2",
    "kapture-mcp": "2.6.1",
    "playwright-core": "1.64.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.64.1"
  },
  "keywords": [
    "mcp",
    "browser-automation",
    "computer-use",
    "jev",
    "typesafe",
    "kapture",
    "claude-code",
    "codex"
  ],
  "license": "MIT"
}
