{
  "name": "jevsteer",
  "version": "0.2.0",
  "description": "Verified low-cost browser execution for coding agents: Jev decisions + Kapture control of your existing Chrome, exposed as one MCP server.",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "bin": {
    "jevsteer": "./bin/jevsteer.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "examples/",
    "docs/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "AGENTS.md",
    "CLAUDE.md",
    ".env.example"
  ],
  "scripts": {
    "start": "node bin/jevsteer.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "cheerio": "^1.1.2",
    "kapture-mcp": "2.6.1",
    "zod": "^4.1.5"
  },
  "keywords": [
    "mcp",
    "browser-automation",
    "computer-use",
    "jev",
    "typesafe",
    "kapture",
    "claude-code",
    "codex"
  ],
  "license": "MIT"
}
