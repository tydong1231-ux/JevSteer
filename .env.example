TYPESAFE_API_KEY=ts_your_key_here
# Alternative: use Jev through OpenRouter's System One API (not chat/completions).
# JEV_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_key
# Optional overrides
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest
# Optional low-cost text generation (for non-secret fields without host values)
# TEXT_MODEL_API_KEY=your_provider_key
# TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
# TEXT_MODEL=deepseek-chat
# KAPTURE_PORT=61822
# BrowserDriver migration: explicit opt-in until live comparison gates pass.
# JEVSTEER_BROWSER_DRIVER=playwright
# JEVSTEER_BROWSER_PROFILE=C:/jevsteer-profiles/demo
# JEVSTEER_BROWSER_CHANNEL=chrome
# JEVSTEER_HEADLESS=1
# JEVSTEER_INPUT_MODE=realistic
# JEVSTEER_BROWSER_TIMEOUT_MS=15000
# Optional existing debug-enabled Chrome; no fallback browser on attach failure.
# JEVSTEER_CDP_ENDPOINT=http://127.0.0.1:9222
# Chrome 144+ existing default browser: manually enable remote debugging at
# chrome://inspect/#remote-debugging, then personally approve the connection.
# Alternative to the URL above (do not configure both):
# JEVSTEER_CDP_ENDPOINT=chrome
# JEVSTEER_LOG=1
# JEVSTEER_LEASE_TTL_MS=120000
# JEVSTEER_VERIFY_PASS_AT=0.82
# JEVSTEER_VERIFY_FAIL_AT=0.35
# JEVSTEER_DRIFT_STOP_AT=0.25
# JEVSTEER_DRIFT_RECOVER_AT=0.12
# JEVSTEER_SIDE_EFFECT_SAFE_AT=0.20
# JEVSTEER_CONSTRAINT_RISK_AT=0.55
# JEVSTEER_MAX_AUTO_RECOVERIES=2
# JEVSTEER_NEXT_STEP_CLEAR_AT=0.45
# JEVSTEER_STATE_DIR=/absolute/persistent/path/to/jevsteer-actions
# JEVSTEER_ACTION_SETTLE_MS=8000
# JEVSTEER_NAVIGATION_SETTLE_MS=15000
# JEVSTEER_OBSERVATION_QUIET_MS=250
# JEVSTEER_MAX_WAITS=12
